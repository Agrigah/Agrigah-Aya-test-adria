enum TransactionType { DEBIT CREDIT }

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    type: TransactionType!
    createdAt: String!
}

type TransferResult {
    debit: Transaction!
    credit: Transaction!
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    type: TransactionType
}

type Query {
    transactions(accountId: ID): [Transaction!]!
    transactionById(id: ID!): Transaction
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): Transaction!
    transfer(fromAccountId: ID!, toAccountId: ID!, amount: Float!, currency: String!): TransferResult!
}
